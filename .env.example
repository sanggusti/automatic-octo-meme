# --- Inference providers (OpenAI-compatible) ---
# Baseten Model APIs: https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Modal-hosted vLLM server (see infra/modal/vllm_server.py); set after `modal deploy`
MODAL_API_KEY=
MODAL_BASE_URL=

# --- Simulation backend: mock | gazebo-sitl | colosseum ---
DMB_SIM_BACKEND=mock
# Comma-separated scenario names, or "all"
DMB_SCENARIOS=all

# --- Run tracking ---
DMB_RUNS_DIR=runs

# --- Edge perception budgets ---
DMB_EDGE_REPORT_INTERVAL_STEPS=5
DMB_EDGE_MAX_SNAPSHOTS_PER_EPISODE=8
# Edge backend: stub (rule-based) | sam (SAM 3.1 seg-maps + route tool)
DMB_EDGE_PERCEPTION=stub

# --- Edge VLM (live detector baseline; stub-completer in tests) ---
DMB_VLM_BASE_URL=
DMB_VLM_API_KEY=
DMB_VLM_MODEL=

# --- SAM 3.1 seg-maps (route mapping; native frames only, stub in tests) ---
DMB_SAM_BASE_URL=https://api.meta.ai/v1
DMB_SAM_API_KEY=
# META_AI_API_KEY is used when DMB_SAM_API_KEY is empty (shared Meta key).
DMB_SAM_MODEL=sam-3.1

# --- Flywheel (Phase D) ---
# DMB_VISION=text forces text-only tool results (text teachers navigate on
# edge reports; multimodal models omit this for text+image results).
# DMB_WATCH_DIR= runs/flytrain-v1/trajectories
# DMB_WATCH=off disables L2 recording.
